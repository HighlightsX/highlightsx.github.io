---
// One stable illustration per post: a contribution grid derived from the slug,
// so a post always gets the same image and nothing has to be stored. Density
// rises to the right, which is the shape of a project that just got busy - the
// same thing the post is about.
interface Props {
  slug: string;
  icon: string;
  color: string;
}
const { slug, icon, color } = Astro.props;

const W = 400;
const H = 220;
const CELL = 13;
const GAP = 4;
const STEP = CELL + GAP;
const ROWS = 7;
const COLS = 22;
const X0 = 18;
const Y0 = (H - (ROWS * STEP - GAP)) / 2;

let seed = 0;
for (const ch of slug) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;

// mulberry32: small, deterministic, good enough for placing cells.
const rand = (() => {
  let a = seed || 1;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
})();

// Four filled levels plus empty, the same ladder GitHub uses. The chance of a
// cell being lit climbs from 20% at the left edge to 95% at the right.
const LEVELS = [0, 0.18, 0.34, 0.55, 0.85];
const cells: { x: number; y: number; level: number }[] = [];
const weekTotals: number[] = [];

for (let c = 0; c < COLS; c++) {
  const pressure = 0.2 + (c / (COLS - 1)) * 0.75;
  let total = 0;
  for (let r = 0; r < ROWS; r++) {
    const lit = rand() < pressure;
    const level = lit ? 1 + Math.floor(rand() * pressure * 4) : 0;
    total += level;
    cells.push({ x: X0 + c * STEP, y: Y0 + r * STEP, level: Math.min(level, 4) });
  }
  weekTotals.push(total);
}

// A trend line over the weekly sums, drawn faintly across the grid so the
// rising shape reads even at card size.
const maxTotal = Math.max(...weekTotals, 1);
const trend = weekTotals
  .map((t, c) => `${c === 0 ? 'M' : 'L'} ${X0 + c * STEP + CELL / 2} ${Y0 + (1 - t / maxTotal) * (ROWS * STEP - GAP)}`)
  .join(' ');
---

<svg class="thumb" viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <rect width={W} height={H} fill={color} opacity=".08" />

  {cells.map(({ x, y, level }) => (
    <rect
      x={x}
      y={y}
      width={CELL}
      height={CELL}
      rx="3"
      fill={level === 0 ? 'var(--line)' : color}
      opacity={level === 0 ? 0.5 : LEVELS[level]}
    />
  ))}

  <path d={trend} fill="none" stroke={color} stroke-width="2" opacity=".5" stroke-linecap="round" stroke-linejoin="round" />

  <g
    transform="translate(300 40) scale(4)"
    fill="none"
    stroke={color}
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity=".14"
  >
    <path d={icon} />
  </g>
</svg>
