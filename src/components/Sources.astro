---
import { enDate } from '../lib/format';

interface Props {
  sources: { label: string; url: string; publisher: string; published: Date }[];
}
const { sources } = Astro.props;
---

<section class="sources">
  <h2>Sources</h2>
  <ol>
    {sources.map((s) => (
      <li>
        <a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a>
        <span class="pub"> · {s.publisher} · {enDate(s.published)}</span>
      </li>
    ))}
  </ol>
</section>
