---
import { age, compactNumber, enDate, isoDate } from '../lib/format';
import type { CollectionEntry } from 'astro:content';

interface Props {
  repo: CollectionEntry<'news'>['data']['repo'];
}
const { repo } = Astro.props;

// Every figure here is the snapshot the post was written against. Nothing is
// fetched at build time, so the numbers cannot drift away from the prose.
const facts = [
  { k: 'Stars', v: compactNumber(repo.stars) + (repo.starsGained ? ` (+${compactNumber(repo.starsGained)})` : '') },
  { k: 'Language', v: repo.language ?? '—' },
  { k: 'License', v: repo.license },
  { k: 'Age', v: age(repo.createdAt) },
  { k: 'Last push', v: enDate(repo.pushedAt) },
  ...(repo.latestRelease ? [{ k: 'Latest release', v: `${repo.latestRelease.tag} · ${enDate(repo.latestRelease.date)}` }] : []),
];
---

<section class="repo-facts">
  <a class="repo-name" href={repo.url} rel="nofollow noopener" target="_blank">
    <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18" fill="currentColor">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
    </svg>
    <span><span class="owner">{repo.owner}/</span>{repo.name}</span>
  </a>

  <dl>
    {facts.map((f) => (
      <div>
        <dt>{f.k}</dt>
        <dd>{f.v}</dd>
      </div>
    ))}
  </dl>

  <p class="snapshot">
    Figures as of <time datetime={isoDate(repo.snapshotAt)}>{enDate(repo.snapshotAt)}</time>.
    {repo.homepage && (
      <> Project site: <a href={repo.homepage} rel="nofollow noopener" target="_blank">{new URL(repo.homepage).host}</a>.</>
    )}
  </p>
</section>
