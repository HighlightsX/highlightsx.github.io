---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import NewsCard from '../components/NewsCard.astro';
import RepoFacts from '../components/RepoFacts.astro';
import { categories } from '../data/site';
import { publishedNews } from '../lib/posts';

const posts = (await publishedNews()).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

// A featured post is opened in full here instead of appearing as a card, so it
// is never listed twice on the same page.
const featured = posts.find((p) => p.data.featured);
const rest = posts.filter((p) => p !== featured);
const Featured = featured ? (await render(featured)).Content : null;
const featuredCat = featured ? categories[featured.data.category] : null;
---

<Base>
  <div class="wrap with-sidebar">
    <main>
      <h1>New on <em>GitHub</em>, explained</h1>
      <p class="lede">
        One project per post: what it does, why it surfaced now, how it works and where it is
        weak. Every figure carries the date it was true. Two posts a day.
      </p>

      {featured && Featured && featuredCat && (
        <article class="post featured" style={`--cat: ${featuredCat.color}`}>
          <span class="tag">Featured · {featuredCat.name}</span>
          <h2><a href={`/${featured.id}`}>{featured.data.title}</a></h2>
          <p class="lede">{featured.data.description}</p>
          <RepoFacts repo={featured.data.repo} />
          <div class="post-body"><Featured /></div>
        </article>
      )}

      {rest.length === 0 ? (
        <p class="empty">No highlights yet.</p>
      ) : (
        <>
          <h2 class="section-title">Latest</h2>
          <div class="cards">
            {rest.map((post) => <NewsCard post={post} />)}
          </div>
        </>
      )}
    </main>
    <Sidebar />
  </div>
</Base>

<style>
  .featured {
    margin-block: var(--space-8, 2rem);
    padding-block-end: var(--space-8, 2rem);
    border-block-end: 1px solid var(--line, rgba(128, 128, 128, 0.25));
  }
  .featured h2 {
    margin-block: 0.5rem;
    font-size: 2rem;
    line-height: 1.15;
  }
  .featured h2 a {
    color: inherit;
    text-decoration: none;
  }
  .featured h2 a:hover {
    text-decoration: underline;
  }
</style>
