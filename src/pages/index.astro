---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import NewsCard from '../components/NewsCard.astro';
import { publishedNews } from '../lib/posts';

const posts = (await publishedNews()).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Base>
  <div class="wrap with-sidebar">
    <main>
      <h1>New on <em>GitHub</em>, explained</h1>
      <p class="lede">
        One project per post: what it does, why it surfaced now, how it works and where it is
        weak. Every figure carries the date it was true. Two posts a day.
      </p>

      {posts.length === 0 ? (
        <p class="empty">No highlights yet.</p>
      ) : (
        <>
          <h2 class="section-title">Latest</h2>
          <div class="cards">
            {posts.map((post) => <NewsCard post={post} />)}
          </div>
        </>
      )}
    </main>
    <Sidebar />
  </div>
</Base>
