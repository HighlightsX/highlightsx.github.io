---
import { site, categories } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import A11yWidget from '../components/A11yWidget.astro';
import { cleanPath } from '../lib/format';
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  post?: {
    publishDate: Date;
    category: keyof typeof categories;
    tags: string[];
    sources: { label: string; url: string }[];
    repo: { owner: string; name: string; url: string; language: string | null };
  };
  noindex?: boolean;
}
const { title, description, post, noindex } = Astro.props;

// trailingSlash: 'never', so the slashless form is the one live URL and every
// self-reference has to emit exactly that.
const canonical = new URL(cleanPath(Astro.url), site.url).href;
const desc = description ?? site.description;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;

const schema = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'NewsArticle',
          headline: title,
          description: desc,
          datePublished: post.publishDate.toISOString(),
          dateModified: post.publishDate.toISOString(),
          inLanguage: 'en',
          mainEntityOfPage: canonical,
          image: `${site.url}/og-default.jpg`,
          articleSection: categories[post.category].name,
          keywords: post.tags.join(', '),
          citation: post.sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })),
          publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
          // The post is about one piece of software, and saying so is what lets
          // a search engine connect it to the repository it reviews.
          about: {
            '@type': 'SoftwareSourceCode',
            name: post.repo.name,
            codeRepository: post.repo.url,
            ...(post.repo.language ? { programmingLanguage: post.repo.language } : {}),
            author: { '@type': 'Organization', name: post.repo.owner },
          },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Highlights', item: `${site.url}/` },
            {
              '@type': 'ListItem',
              position: 2,
              name: categories[post.category].name,
              item: `${site.url}/c/${post.category}`,
            },
            { '@type': 'ListItem', position: 3, name: title },
          ],
        },
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: `${site.url}/`,
      inLanguage: 'en',
      description: site.description,
      publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="Gpy2Gc2C9QcIVl08sHTa5Yrw1rgIp6gdurOl8uULd_A" />

    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site.url}/og-default.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {/* runs before first paint: a deferred script would flash the dark theme first */}
    <script is:inline>
      if (localStorage.getItem('gh-theme') === 'light') document.documentElement.classList.add('light');
    </script>
  </head>

  <body>
    <div class="read-progress" id="read-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <div id="main-content">
      <slot />
    </div>
    <A11yWidget />
    <Footer />
    <script src="/site.js" is:inline defer></script>
  </body>
</html>
